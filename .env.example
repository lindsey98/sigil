# Sigil local env — copy to `.env` (gitignored) and fill in.
#
#   cp .env.example .env
#
# litellm (via byLLM) reads these from the process environment at startup. The
# `sigil` launcher does NOT auto-source this file, so either:
#   a) run litellm-backed commands from the repo root (litellm auto-loads .env), or
#   b) export them in your shell first:  set -a; source .env; set +a
#
# ─────────────────────────────────────────────────────────────────────────────
# RELAY / 中转 (an OpenAI-compatible proxy)
# ─────────────────────────────────────────────────────────────────────────────
# Point the OpenAI provider at your relay's base URL and key, then use model
# names prefixed `openai/` so litellm routes them through that endpoint.
OPENAI_API_KEY=sk-your-relay-key
OPENAI_API_BASE=https://your-relay.example.com/v1
# some stacks read OPENAI_BASE_URL instead — set both if unsure:
# OPENAI_BASE_URL=https://your-relay.example.com/v1
#
# Then pick the model (bare `by llm()` default comes from jac.toml [byllm.model];
# for a specific run you can also set one here or via `sigil models`):
# SIGIL_MODEL=openai/gpt-4o-mini
#
# ─────────────────────────────────────────────────────────────────────────────
# Direct providers (uncomment what you actually use)
# ─────────────────────────────────────────────────────────────────────────────
# ANTHROPIC_API_KEY=sk-ant-...
# ZAI_API_KEY=...
# OLLAMA_API_KEY=...            # only for the ollama-cloud/ provider
#
# ─────────────────────────────────────────────────────────────────────────────
# Running the repo from source (debugging, not installed as a package)
# ─────────────────────────────────────────────────────────────────────────────
# SIGIL_JAC=/path/to/jac        # which jac binary the launcher + gates use
# SIGIL_JAC_CHECK=0             # skip the pinned-jac-version check
# SIGIL_FRONTEND=               # legacy|staged to select an older lift front-end
